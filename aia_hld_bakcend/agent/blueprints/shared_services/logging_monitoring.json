{
  "retention_days": 90,
  "aggregation": {
    "tool": "ELK_Stack",
    "endpoints": ["https://log-aggregator.internal:9200"]
  },
  "metrics": {
    "provider": "Prometheus",
    "scrape_interval": "15s"
  },
  "alerts": {
    "default_channel": "#ops-alerts",
    "severity_levels": ["critical", "warning", "info"]
  }
}