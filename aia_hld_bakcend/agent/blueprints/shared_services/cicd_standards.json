{
  "platforms": {
    "github_actions": {
      "required_runners": "self-hosted",
      "enforce_branch_protection": true
    },
    "jenkins": {
      "agent_type": "kubernetes",
      "plugins_allowlist": ["git", "pipeline", "docker-workflow"]
    },
    "ado": {
      "organization": "corp-dev",
      "project_visibility": "private"
    }
  },
  "scan_thresholds": {
    "sast": "medium",
    "dast": "high"
  }
}